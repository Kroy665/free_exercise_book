{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Free Exercise Book",
  "mainBinaryName": "free-exercise-book",
  "version": "0.1.0",
  "identifier": "io.github.kroy665.freeexercisebook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Free Exercise Book",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Free, offline exam preparation for Indian government exams",
    "longDescription": "Topic-wise notes, MCQ practice and mock tests in English and Bengali. Works offline. Free and open source (GPL-3.0).",
    "license": "GPL-3.0-or-later",
    "copyright": "Free Exercise Book contributors",
    "resources": {
      "../../../content/subjects/": "content/subjects/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
