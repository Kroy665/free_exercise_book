{
  "name": "free-exercise-book",
  "version": "0.1.0",
  "description": "Free Exercise Book desktop app (Tauri + SvelteKit)",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "icons": "tauri icon src-tauri/icons/source/icon.svg && node -e \"const fs=require('fs');for(const d of ['android','ios'])fs.rmSync('src-tauri/icons/'+d,{recursive:true,force:true});fs.copyFileSync('src-tauri/icons/64x64.png','static/favicon.png')\"",
    "packs": "cargo run -q --manifest-path ../../Cargo.toml -p feb-packer -- build ../../content --out ../../dist/packs --auto-key ../../dist/dev-key"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@lucide/svelte": "^1.70.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "markdown-it": "^15.0.3",
    "markdown-it-container": "^4.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
