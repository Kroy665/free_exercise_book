{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ca_items.schema.json",
  "title": "Current-affairs items (one month)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "date", "category", "title", "body", "source", "as_of", "status"],
    "properties": {
      "id": { "type": "string", "pattern": "^i\\d{3}$" },
      "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "category": {
        "enum": ["schemes", "appointments", "awards", "sports", "economy", "science", "defence",
                 "environment", "international", "reports-indices", "polity", "states", "obituaries"]
      },
      "title": { "$ref": "localized.schema.json" },
      "body": { "$ref": "localized.schema.json" },
      "key_points": { "type": "array", "items": { "$ref": "localized.schema.json" } },
      "related_topics": { "type": "array", "items": { "type": "string" } },
      "source": { "type": "string", "pattern": "^https://" },
      "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "status": { "enum": ["ai-generated", "reviewed", "verified"] }
    },
    "additionalProperties": false
  }
}
